# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit real keys.

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase → Project Settings → API → service_role key.
# This is a master key that bypasses row-level security. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the "records unlocked" cookie. Any random string of 32+ characters.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# The shared password that opens the Records section (past entries, totals,
# cash position, Excel export). Filling in the daily form needs no password.
RECORDS_PASSWORD=
